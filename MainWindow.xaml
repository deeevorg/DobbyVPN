<Window x:Class="RismanNG.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RismanNG" Height="650" Width="1050" MinHeight="500" MinWidth="780" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" WindowState="Normal" Background="#17191E" Foreground="#F2F4F8">
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="RismanNG" FontWeight="SemiBold" FontSize="25" Margin="0,0,0,28"/><Button Content="Dashboard" Click="Dashboard_Click" HorizontalContentAlignment="Left"/><Button Content="Servers" Click="Servers_Click" HorizontalContentAlignment="Left" Margin="0,8,0,0"/><Button Content="Subscriptions" Click="Subscriptions_Click" HorizontalContentAlignment="Left" Margin="0,8,0,0"/><Button Content="Settings" Click="Settings_Click" HorizontalContentAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="Free and local-first" Opacity=".6" Margin="0,30,0,0"/></StackPanel>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9CC6FF" Text="Disconnected"/></DockPanel>
   <Grid Grid.Row="1" Margin="0,24,0,0"><Grid x:Name="DashboardView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#22252D" CornerRadius="10" Padding="24"><StackPanel><TextBlock Text="Connection" FontSize="17"/><TextBlock x:Name="ActiveProfileText" Margin="0,12,0,18" Opacity=".75" Text="No profile selected"/><StackPanel Orientation="Horizontal"><Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Width="150" Height="42"/><Button Content="Import from clipboard" Click="ImportClipboard_Click" Margin="12,0,0,0" Height="42"/></StackPanel><TextBlock x:Name="MessageText" Foreground="#FFCA8A" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Grid.Row="1" Margin="4,22,0,0" Opacity=".65" Text="System Proxy mode is supported. TUN is intentionally unavailable in this build until a reviewed sing-box binary and driver are configured." TextWrapping="Wrap"/></Grid>
    <Grid x:Name="ServersView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="Import from clipboard" Click="ImportClipboard_Click"/><Button Content="Open config file" Click="ImportFile_Click" Margin="10,0,0,0"/><Button Content="Delete selected" Click="Delete_Click" Margin="10,0,0,0"/></DockPanel><ListBox x:Name="ProfilesList" Grid.Row="1" Margin="0,18,0,0" DisplayMemberPath="DisplayName" SelectionChanged="ProfilesList_SelectionChanged"/></Grid>
    <Grid x:Name="SubscriptionsView" Visibility="Collapsed"><StackPanel><TextBlock Text="Subscription URLs are stored locally with Windows DPAPI." Opacity=".7"/><TextBox x:Name="SubscriptionUrl" Margin="0,16,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Add and refresh" Click="AddSubscription_Click"/><Button Content="Refresh selected" Click="RefreshSubscription_Click" Margin="10,0,0,0"/></StackPanel><ListBox x:Name="SubscriptionsList" Margin="0,18,0,0" DisplayMemberPath="Url"/></StackPanel></Grid>
    <Grid x:Name="SettingsView" Visibility="Collapsed"><StackPanel><TextBlock Text="Settings" FontSize="18"/><TextBlock Margin="0,18,0,0" Text="Connection mode: System Proxy (supported)"/><TextBlock Margin="0,8,0,0" Text="sing-box is included with this test build; no separate installation or path is needed." TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Text="TUN: Experimental and disabled — administrator, driver and binary validation are required." Foreground="#FFCA8A" TextWrapping="Wrap"/></StackPanel></Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
